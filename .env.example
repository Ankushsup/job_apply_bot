# ==========================================
# Job Matcher & Notifier Configuration
# ==========================================

# Minimum Match Score (0 to 100) to trigger alerts
MIN_MATCH_SCORE=70

# Cron Schedule (default: every 1 hour)
# Run every 30 minutes: "*/30 * * * *"
# Run every 1 hour: "0 * * * *"
CRON_SCHEDULE="0 * * * *"

# ==========================================
# Email Configuration (Nodemailer)
# ==========================================
EMAIL_ENABLED=true
EMAIL_USER=ankush.upadhyay2000@gmail.com
# For Gmail, use an App Password (not your normal password):
# Go to: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_TO=ankush.upadhyay2000@gmail.com

# SMTP Settings (Defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# ==========================================
# Telegram Configuration (Optional)
# ==========================================
TELEGRAM_ENABLED=false
# Create bot via @BotFather to get token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Get your numeric chat ID via @userinfobot
TELEGRAM_CHAT_ID=123456789

# ==========================================
# Google Gemini AI API (Optional, but recommended)
# ==========================================
# Free API key from: https://aistudio.google.com/app/apikey
# If left blank, the bot will use a smart heuristic keyword matcher.
GEMINI_API_KEY=

# ==========================================
# Live Google Search API via Serper.dev (Optional - 2,500 free searches)
# ==========================================
# Free key from: https://serper.dev (No credit card required)
# Unlocks live Google Search for LinkedIn HR hiring posts & company emails!
SERPER_API_KEY=


